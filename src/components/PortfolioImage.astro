---
// Optimiertes Portfolio-Bild: erzeugt beim Build WebP-Varianten in mehreren
// Breiten (srcset) mit festen Maßen. `src` wird wie bisher als Pfad
// "/images/portfolio/..." angegeben; die Datei liegt unter src/assets/.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: string;
  alt: string;
  widths?: number[];
  sizes?: string;
  class?: string;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  'aria-hidden'?: 'true' | 'false';
}

const images = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/images/portfolio/**/*.{jpg,jpeg,JPG,JPEG,png}',
  { eager: true }
);

const {
  src,
  alt,
  widths = [400, 600, 900],
  sizes = '(max-width: 900px) 50vw, (max-width: 1400px) 33vw, 420px',
  loading = 'lazy',
  ...rest
} = Astro.props;

const image = images[`/src/assets${src}`]?.default;
if (!image) {
  throw new Error(`Portfolio-Bild nicht gefunden: src/assets${src}`);
}

// Nie über die Originalgröße hinaus hochskalieren
const usableWidths = widths.filter((w) => w < image.width);
if (usableWidths.length === 0 || Math.max(...widths) >= image.width) usableWidths.push(image.width);
---

<Image
  src={image}
  alt={alt}
  widths={usableWidths}
  width={Math.max(...usableWidths)}
  sizes={sizes}
  format="webp"
  loading={loading}
  decoding={loading === 'eager' ? 'auto' : 'async'}
  {...rest}
/>
