---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import PortfolioImage from '../../components/PortfolioImage.astro';
import '../../styles/portfolio.css';

const weddings = [
  {
    type: 'Kirchliche Trauung',
    names: 'Laura & Daniel',
    date: '05.08.2023',
    cover: '/images/portfolio/hochzeiten/laura-daniel/cover.jpg',
    href: '/hochzeiten/laura-daniel',
  },
  {
    type: 'Standesamtliche Trauung',
    names: 'Merve & Okan',
    date: '26.06.2024',
    cover: '/images/portfolio/hochzeiten/merve-okan/cover.jpg',
    href: '/hochzeiten/merve-okan',
  },
  {
    type: 'Freie Trauung',
    names: 'Tabea & Sascha',
    date: '20.07.2024',
    cover: '/images/portfolio/hochzeiten/tabea-sascha/cover.jpg',
    href: '/hochzeiten/tabea-sascha',
  },
];

const mainPhotos = Array.from({ length: 150 }, (_, i) => ({
  src: `/images/portfolio/hochzeiten/galerie/hochzeit-${i + 1}.jpg`,
  alt: `Hochzeit – Impression ${i + 1}`,
}));
---

<BaseLayout
  title="Hochzeiten Portfolio – MiNi Photography"
  description="Echte Momente, echte Gefühle – unser Portfolio der schönsten Hochzeiten. Cineastische Hochzeitsfotografie von Miette & Nicolai."
>
  <Nav />
  <main id="main">

    <!-- Hero -->
    <section class="pf-hero pf-hero--has-img" aria-label="Portfolio Hochzeiten">
      <PortfolioImage class="pf-hero__bg" src="/images/portfolio/hochzeiten/cover.jpg" alt="" aria-hidden="true" loading="eager" fetchpriority="high" widths={[800, 1280, 1920]} sizes="100vw" />
      <div class="pf-hero__inner">
        <a href="/hochzeiten" class="pf-hero__back">
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="13" y1="8" x2="3" y2="8"/><polyline points="7,4 3,8 7,12"/>
          </svg>
          Hochzeitsfotografie
        </a>
        <span class="pf-hero__label">Portfolio</span>
        <h1 class="pf-hero__title">Hoch<em>zeiten.</em></h1>
        <p class="pf-hero__count">Einblicke in unsere Hochzeitsreportagen.</p>
      </div>
    </section>

    <!-- Intro -->
    <div class="pf-intro">
      <div class="pf-intro__inner">
        <div class="pf-intro__text">
          <h2 class="pf-intro__heading">Jede Hochzeit ist einzigartig –<br/>wie die Menschen dahinter.</h2>
          <p class="pf-intro__sub">Wir halten eure Momente so fest, wie sie wirklich waren: ungestellt, emotional und zeitlos.</p>
        </div>
        <a href="/hochzeiten" class="pf-intro__link">
          Mehr über Hochzeitsfotografie
          <svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="3" y1="8" x2="13" y2="8"/><polyline points="9,4 13,8 9,12"/>
          </svg>
        </a>
      </div>
    </div>

    <!-- Wedding Gallery Tiles -->
    <section class="w-galleries" aria-label="Unsere Hochzeiten">
      <div class="w-galleries__inner">
        <div class="w-galleries__header">
          <span class="w-galleries__label">Unsere Hochzeiten</span>
          <h2 class="w-galleries__title">Drei <em>besondere Tage.</em></h2>
        </div>
        <div class="w-galleries__grid">
          {weddings.map((w) => (
            <a href={w.href} class="w-tile" aria-label={`Galerie ansehen: ${w.names}`}>
              <img src={w.cover} alt={`${w.names} – ${w.type}`} loading="lazy" />
              <div class="w-tile__gradient"></div>
              <div class="w-tile__top">
                <div class="w-tile__view">
                  <span class="w-tile__view-text">Galerie ansehen</span>
                  <span class="w-tile__view-icon" aria-hidden="true">
                    <svg width="11" height="11" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                      <line x1="3" y1="8" x2="13" y2="8"/><polyline points="9,4 13,8 9,12"/>
                    </svg>
                  </span>
                </div>
              </div>
              <div class="w-tile__info">
                <span class="w-tile__type">{w.type}</span>
                <span class="w-tile__names">{w.names}</span>
                <span class="w-tile__date">{w.date}</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Mixed Grid Intro -->
    <div class="pf-mixed-intro">
      <div class="pf-mixed-intro__inner">
        <div>
          <h2 class="pf-mixed-intro__heading">Weitere Eindrücke aus unserer <em>Hochzeitsfotografie.</em></h2>
        </div>
      </div>
    </div>

    <!-- Mixed Photo Grid -->
    <section class="pf-grid-section" aria-label="Hochzeitsimpressionen">
      <div class="pf-grid-section__inner">
        <div class="pf-grid">
          {mainPhotos.map((p) => (
            <div class="pf-item">
              <PortfolioImage src={p.src} alt={p.alt} />
              <div class="pf-item__overlay"></div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="pf-cta">
      <div class="pf-cta__inner">
        <span class="pf-cta__label">Euer Tag, unsere Linse</span>
        <h2 class="pf-cta__heading">Bereit für <em>euren großen Tag?</em></h2>
        <div class="pf-cta__btns">
          <a href="/#kontakt" class="pf-cta__btn pf-cta__btn--primary">
            Jetzt anfragen
            <svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="3" y1="8" x2="13" y2="8"/><polyline points="9,4 13,8 9,12"/>
            </svg>
          </a>
          <a href="/preise" class="pf-cta__btn pf-cta__btn--secondary">Preise & Pakete</a>
        </div>
      </div>
    </section>

  </main>
  <Footer />

  <script>
    /* Hide broken placeholder images gracefully */
    document.querySelectorAll<HTMLImageElement>('.pf-item img, .w-tile img').forEach(img => {
      img.addEventListener('error', () => { img.style.visibility = 'hidden'; });
    });
  </script>
</BaseLayout>
