  overflow: hidden;
}
.lh-chapnav__item:hover { opacity: 0.7; }
.lh-chapnav__item:focus-visible { outline: 1px solid var(--color-clay); outline-offset: -2px; }
.lh-chapnav__item.is-active { opacity: 1; }
.lh-chapnav__num {
