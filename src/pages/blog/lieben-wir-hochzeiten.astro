}
.lh-hero__back {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  font-family: var(--font-body);
  font-size: 0.62rem;
  letter-spacing: 0.32em;
  text-transform: uppercase;
  color: rgba(196,181,172,0.45);
  transition: color 0.25s ease;
  align-self: flex-start;
}
.lh-hero__back:hover { color: rgba(196,181,172,1); }
.lh-hero__back:focus-visible { outline: 1px solid rgba(196,181,172,0.6); outline-offset: 4px; }
.lh-hero__copy {
