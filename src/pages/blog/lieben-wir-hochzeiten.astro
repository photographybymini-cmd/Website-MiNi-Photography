  top: 0;
  z-index: 30;
  background: var(--color-cream);
  border-bottom: 1px solid rgba(196,181,172,0.18);
}
.lh-chapnav__inner {
  max-width: var(--container-max);
  margin-inline: auto;
  padding: 0 var(--container-gutter);
  display: grid;
  grid-template-columns: repeat(3, 1fr);
}
.lh-chapnav__item {
  position: relative;
  display: flex;
  align-items: center;
  gap: 0.55rem;
  padding: 0.9rem 0;
  opacity: 0.35;
