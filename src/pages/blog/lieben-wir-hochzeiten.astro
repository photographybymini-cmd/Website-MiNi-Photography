  font-size: 0.65rem;
  letter-spacing: 0.28em;
  text-transform: uppercase;
  color: var(--color-cream);
  border: 1px solid rgba(196,181,172,0.25);
  padding: 1rem 2.25rem;
  transition: background 0.25s ease, border-color 0.25s ease, gap 0.2s ease;
  align-self: flex-start;
  margin-top: 0.25rem;
}
.lh-fazit__cta:hover {
  background: rgba(196,181,172,0.1);
  border-color: rgba(196,181,172,0.5);
  gap: 1.1rem;
}
.lh-fazit__cta:focus-visible { outline: 1px solid rgba(196,181,172,0.6); outline-offset: 4px; }

/* ── Back Button ─────────────────────────────────────── */
.blog-back {
  background: var(--color-parchment);
  border-top: 1px solid rgba(196,181,172,0.2);
  padding: clamp(2rem, 4vw, 3rem) var(--container-gutter);
  display: flex;
  justify-content: center;
}
.blog-back__link {
  display: inline-flex;
  align-items: center;
  gap: 0.75rem;
  font-family: var(--font-body);
  font-size: 0.65rem;
  letter-spacing: 0.3em;
  text-transform: uppercase;
  color: var(--color-clay);
  transition: color 0.2s ease, gap 0.2s ease;
}
.blog-back__link:hover {
  color: var(--color-bark);
  gap: 1.1rem;
}

/* ── Reveal ─────────────────────────────────────────── */
.lh-reveal {
  opacity: 0;
  transform: translateY(20px);
  transition: opacity 0.72s ease var(--delay, 0s), transform 0.72s ease var(--delay, 0s);
}
.lh-reveal.is-visible {
  opacity: 1;
  transform: none;
}

/* ── Reduced Motion ─────────────────────────────────── */
@media (prefers-reduced-motion: reduce) {
  .lh-reveal { opacity: 1; transform: none; transition: none; }
  .lh-chapnav__bar { transition: none; }
  .lh-fazit__cta { transition: none; }
  .lh-story__chevron { transition: none; }
}

/* ── Mobile ─────────────────────────────────────────── */
@media (max-width: 860px) {
  .lh-sect__inner {
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  .lh-sect__head { position: static; }
}

@media (max-width: 640px) {
  .lh-chapnav__label { display: none; }
  .lh-chapnav__item { justify-content: center; padding: 0.75rem 0; }
  .lh-chapnav__num { letter-spacing: 0.2em; font-size: 0.6rem; }
  .lh-sect__ghost { font-size: clamp(9rem, 38vw, 13rem); }
  .lh-story__summary { grid-template-columns: 1.75rem 1fr auto; gap: 0.75rem; }
  .lh-story__content { padding-left: 2.5rem; }
  .lh-hero__img { object-position: 25% 50%; }
  .lh-story__img--portrait { max-height: 420px; }
}
</style>

<script>
  // ── Scroll reveals ────────────────────────────────────
  const reveals = document.querySelectorAll('.lh-reveal');
  const revealObs = new IntersectionObserver(
    (entries) => entries.forEach(e => {
      if (e.isIntersecting) { e.target.classList.add('is-visible'); revealObs.unobserve(e.target); }
    }),
    { threshold: 0.12 }
  );
  reveals.forEach(el => revealObs.observe(el));

  // ── Chapter nav active state ──────────────────────────
  const chapItems = document.querySelectorAll<HTMLElement>('.lh-chapnav__item');
  const sectSections = document.querySelectorAll('.lh-sect');

  const chapObs = new IntersectionObserver(
    (entries) => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          chapItems.forEach(item =>
            item.classList.toggle('is-active', item.dataset.id === e.target.id)
          );
        }
      });
    },
    { rootMargin: '-25% 0px -65% 0px' }
  );
  sectSections.forEach(s => chapObs.observe(s));
</script>
