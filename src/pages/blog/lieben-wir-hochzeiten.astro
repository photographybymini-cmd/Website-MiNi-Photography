}

/* ── Accordion ──────────────────────────────────────── */
.lh-story__details {
  width: 100%;
}
.lh-story__details summary {
  list-style: none;
}
.lh-story__details summary::-webkit-details-marker {
  display: none;
}
.lh-story__summary {
  display: grid;
  grid-template-columns: 2.25rem 1fr auto;
  gap: 1rem;
  align-items: center;
  padding: 1.25rem 0;
  cursor: pointer;
  user-select: none;
}
.lh-story__summary:focus-visible {
  outline: 1px solid var(--color-clay);
  outline-offset: 2px;
}
.lh-story__num {
  font-family: var(--font-body);
  font-size: 0.55rem;
  letter-spacing: 0.3em;
