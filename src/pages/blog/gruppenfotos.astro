</style>

<script>
  // ── Scroll reveals ────────────────────────────────────
  const reveals = document.querySelectorAll('.gf-reveal');
  const revealObs = new IntersectionObserver(
    (entries) => entries.forEach(e => {
      if (e.isIntersecting) { e.target.classList.add('is-visible'); revealObs.unobserve(e.target); }
    }),
    { threshold: 0.12 }
  );
  reveals.forEach(el => revealObs.observe(el));

  // ── Chapter nav active state ──────────────────────────
  const chapItems = document.querySelectorAll<HTMLElement>('.gf-chapnav__item');
  const sectSections = document.querySelectorAll('.gf-sect');

  const chapObs = new IntersectionObserver(
    (entries) => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          chapItems.forEach(item =>
            item.classList.toggle('is-active', item.dataset.id === e.target.id)
          );
        }
      });
    },
    { rootMargin: '-25% 0px -65% 0px' }
  );
  sectSections.forEach(s => chapObs.observe(s));
</script>
